# Zoho Books OAuth2 credentials for direct env use (workers, or CLI without a config file).
# CLIENT_ID, CLIENT_SECRET, REFRESH_TOKEN and ORGANIZATION_ID must all be set for the env
# credential path to activate; REGION is optional (default: com).
#
# region: one of com | eu | in | com.au | jp | ca | com.cn | sa  (default: com)
FOB_ZB_REGION=com
FOB_ZB_CLIENT_ID=1000.XXXXXXXXXXXXXXXXXXXX
FOB_ZB_CLIENT_SECRET=yyyyyyyyyyyyyyyyyyyyyyyy
# Long-lived refresh token minted once via the self-client / consent flow.
FOB_ZB_REFRESH_TOKEN=1000.aaaaaaaa.bbbbbbbb
# The Zoho organization (tenant) id — get it from `fob-zb organizations list`.
FOB_ZB_ORGANIZATION_ID=8927xxxxxx

# Override the CLI config directory (tests, containers, CI). Defaults to ~/.fob/fob-zb
# FOB_ZB_CONFIG_DIR=/tmp/fob-zb-test

# Set to see full stack traces on error.
# FOB_DEBUG=1
